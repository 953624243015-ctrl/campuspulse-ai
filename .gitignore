# ─── Dependencies ────────────────────────────────────────────
node_modules/
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ─── Build outputs (keep dist/ for backend – needed to run without compiling) ─
# dist/        <-- intentionally NOT ignored so backend runs from GitHub clone
build/
*.egg-info/

# ─── Environment files (never commit real secrets) ───────────
.env
# Keep example files
!.env.example
!backend/.env.example
!ai-service/.env.example
!frontend/.env.example

# ─── Logs ────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
npm-install.log

# ─── OS ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── IDE ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp

# ─── Uploads ─────────────────────────────────────────────────
backend/uploads/

# ─── Python model/data files ─────────────────────────────────
ai-service/models/*.pkl
ai-service/data/*.csv

# ─── Local PostgreSQL cluster (dev only) ─────────────────────
campuspulse_pgdata/
campuspulse_pg.log

# ─── Docker volumes ──────────────────────────────────────────
postgres_data/

# ─── Local frontend copy (dev workaround for network drive) ──
campuspulse_frontend/
